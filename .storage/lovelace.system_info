{
  "version": 1,
  "minor_version": 1,
  "key": "lovelace.system_info",
  "data": {
    "config": {
      "title": "Energy & system information",
      "views": [
        {
          "title": "energy",
          "path": "energy",
          "icon": "mdi:chart-multiple",
          "type": "sections",
          "max_columns": 3,
          "sections": [
            {
              "type": "grid",
              "cards": [
                {
                  "type": "heading",
                  "heading": "historic energy consumption",
                  "heading_style": "title",
                  "icon": "mdi:lightning-bolt"
                },
                {
                  "type": "custom:energy-period-selector-plus",
                  "card_background": true,
                  "today_button": true,
                  "prev_next_buttons": true,
                  "today_button_type": "text",
                  "period_buttons": [
                    "day",
                    "week",
                    "month",
                    "year",
                    "custom"
                  ],
                  "compare_button_label": "compare",
                  "compare_button_type": "",
                  "grid_options": {
                    "columns": "full"
                  }
                },
                {
                  "type": "custom:energy-flow-card-plus",
                  "entities": {
                    "grid": {
                      "entity": {
                        "consumption": "sensor.home_energy_meter_gen5_electric_consumption_kwh"
                      }
                    },
                    "home": {},
                    "individual1": {
                      "name": "NAS/network",
                      "icon": "mdi:server-network",
                      "color_value": true,
                      "color_icon": false,
                      "calculate_flow_rate": false
                    },
                    "individual2": {
                      "name": "Office",
                      "icon": "mdi:desk",
                      "color_value": true
                    },
                    "fossil_fuel_percentage": {
                      "show": true,
                      "entity": "sensor.electricity_maps_grid_fossil_fuel_percentage",
                      "color_value": true,
                      "color_icon": false,
                      "use_metadata": false,
                      "display_zero": false
                    }
                  },
                  "clickable_entities": true,
                  "display_zero_lines": true,
                  "use_new_flow_rate_model": true,
                  "energy_date_selection": true,
                  "wh_decimals": 1,
                  "kwh_decimals": 0,
                  "min_flow_rate": 1,
                  "max_flow_rate": 6,
                  "max_expected_energy": 2000,
                  "min_expected_energy": 10,
                  "wh_kwh_threshold": 1000,
                  "dashboard_link": "/energy"
                },
                {
                  "square": false,
                  "columns": 3,
                  "type": "grid",
                  "cards": [
                    {
                      "type": "statistic",
                      "entity": "sensor.home_energy_meter_gen5_electric_consumption_kwh",
                      "period": {
                        "calendar": {
                          "period": "month",
                          "offset": -1
                        }
                      },
                      "stat_type": "change",
                      "name": "last month"
                    },
                    {
                      "type": "statistic",
                      "entity": "sensor.home_energy_meter_gen5_electric_consumption_kwh",
                      "period": {
                        "calendar": {
                          "period": "week",
                          "offset": -1
                        }
                      },
                      "stat_type": "change",
                      "name": "last week"
                    },
                    {
                      "type": "statistic",
                      "entity": "sensor.home_energy_meter_gen5_electric_consumption_kwh",
                      "period": {
                        "calendar": {
                          "period": "day",
                          "offset": -1
                        }
                      },
                      "stat_type": "change",
                      "name": "yesterday"
                    },
                    {
                      "type": "statistic",
                      "entity": "sensor.home_energy_meter_gen5_electric_consumption_kwh",
                      "period": {
                        "calendar": {
                          "period": "month"
                        }
                      },
                      "stat_type": "change",
                      "name": "this month"
                    },
                    {
                      "type": "statistic",
                      "entity": "sensor.home_energy_meter_gen5_electric_consumption_kwh",
                      "period": {
                        "calendar": {
                          "period": "week"
                        }
                      },
                      "stat_type": "change",
                      "name": "this week"
                    },
                    {
                      "type": "statistic",
                      "entity": "sensor.home_energy_meter_gen5_electric_consumption_kwh",
                      "period": {
                        "calendar": {
                          "period": "day"
                        }
                      },
                      "stat_type": "change",
                      "name": "today"
                    }
                  ]
                }
              ],
              "column_span": 1
            },
            {
              "type": "grid",
              "cards": [
                {
                  "type": "heading",
